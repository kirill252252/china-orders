# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=china_orders
POSTGRES_USER=app_user
POSTGRES_PASSWORD=secure_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=super_secret_access_key_min_32_chars_change_in_prod
JWT_REFRESH_SECRET=super_secret_refresh_key_min_32_chars_change_in_prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Auth (модуль auth: токены, bcrypt, CORS)
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_IMPORT_MAX=20
RATE_LIMIT_IMPORT_WINDOW_MS=60000

# Mock provider (для демо)
MOCK_PROVIDER_ENABLED=true